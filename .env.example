# Configurações do Servidor
PORT=3000

# Configuração de Envio de E-mail (SMTP)
# Para Gmail: use smtp.gmail.com na porta 587 (com senha de app gerada na conta Google)
# Para cPanel / Hospedagem própria: use mail.polimeter.com.br na porta 465 ou 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Destinatário que receberá os e-mails do formulário
EMAIL_DESTINATARIO=biamendes.profissional@gmail.com
